QScrollBar {{
    width: 0px;
    height: 0px;
}}

#MainWindow {{
    background-color: {background};
    border-radius: 12px;
}}

QListWidget {{
    background-color: {background};
    border: none;
    outline: none;
}}

QListWidget::item {{
    background: transparent;
    color: {text};
}}

QListWidget::item:selected {{
    background: {selected_background};
    border: 4px solid {border};
    border-radius: 8px;
    color: {selected_text};
}}

#ClipboardText {{
    color: {text};
}}

#ClipboardText[selected="true"] {{
    color: {selected_text};
}}